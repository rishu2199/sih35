# ==============================================================================
# METROLOGIX-76 Offline Backend Container
# Multi-stage lightweight Python 3.12 image for air-gapped lab deployment
# ==============================================================================
FROM python:3.12-slim AS builder

WORKDIR /app

# Install build dependencies for C-extensions if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libglib2.0-0 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# --- Runtime Stage ---
FROM python:3.12-slim AS runner

WORKDIR /app

# Install minimal runtime shared libraries for OpenCV headless and font rendering
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    libgl1 \
    libgomp1 \
    tesseract-ocr \
    && rm -rf /var/lib/apt/lists/*

# Copy installed Python packages from builder
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Copy backend application source
COPY backend/app /app/app
COPY backend/alembic.ini /app/alembic.ini

# Expose FastAPI port
EXPOSE 8000

# Healthcheck for air-gapped container orchestrator
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Start Uvicorn ASGI server with embedded SQLite database
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
