# ============================================================
# METROLOGIX-76 — Environment Variables Template
# Copy this file to `.env` and fill in values.
# NEVER commit `.env` to version control.
# ============================================================

# --- Application ---
APP_ENV=development                   # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TITLE=METROLOGIX-76
APP_VERSION=1.0.0

# --- Database ---
# Use SQLite for local/offline mode (default), PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./metrologix.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/metrologix

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_KEY_MIN_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- ECDSA Signing (Lab Director Certificate) ---
# Paths to PEM files for digital report signing
LAB_PRIVATE_KEY_PATH=./keys/lab_private.pem
LAB_PUBLIC_KEY_PATH=./keys/lab_public.pem

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- eMaap Verification Base URL ---
EMAAP_VERIFY_BASE_URL=https://emaap.doca.gov.in/verify

# --- Logging ---
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
